/**
 * @addtogroup dmosal
 * @{
 * @file osal_config.h
 * @brief OSAL resource configuration
 * @copyright Copyright (c) 2023, nguyenvannam142@gmail.com
 * @author Nam Nguyen Van(nguyenvannam142@gmail.com)
 */
#ifndef OSAL_CONFIG_H
#define OSAL_CONFIG_H

#ifdef __cplusplus
extern "C" {
#endif

/**
 * @brief The size of the task name.
 *
 * Defines the size of the task name used in the OS abstraction layer.
 */
#define OSAL_TASK_NAME_SIZE @OSAL_CONFIG_TASK_NAME_SIZE@

/**
 * @brief Stack size of each task in bytes.
 *
 * Used by backends that own the task stack (Zephyr, FreeRTOS). Has no effect
 * on backends that do not use it (Linux).
 */
#define OSAL_TASK_STACK_SIZE_DEFAULT @OSAL_CONFIG_TASK_STACK_SIZE_DEFAULT@

/**
 * @brief Whether each task object embeds its own stack array (1) or not (0).
 *
 * When 0, the backend has no stack memory of its own and
 * osal_task_create() fails unless the caller passes @c stack_addr and
 * @c stack_size. Used by backends that own the task stack (Zephyr,
 * FreeRTOS static allocation). Has no effect on backends that do not use it
 * (Linux).
 */
#define OSAL_TASK_STACK_EMBEDDED @OSAL_CONFIG_TASK_STACK_EMBEDDED@

/**
 * @brief Native priority of the tasks.
 *
 * Interpreted by the backend in its own priority scheme (for example a
 * higher number is a higher priority on FreeRTOS, a lower number is a
 * higher priority on Zephyr). Has no effect on backends that do not use it
 * (Linux).
 */
#define OSAL_TASK_PRIORITY_DEFAULT @OSAL_CONFIG_TASK_PRIORITY_DEFAULT@

/**
 * @brief Maximum number of tasks.
 *
 * Defines the maximum number of tasks allowed in the OS abstraction layer.
 */
#define OSAL_TASK_NUM_MAX @OSAL_CONFIG_TASK_NUM_MAX@

/**
 * @brief Maximum number of mutexes.
 *
 * Defines the maximum number of mutexes allowed in the OS abstraction layer.
 */
#define OSAL_MUTEX_NUM_MAX @OSAL_CONFIG_MUTEX_NUM_MAX@

/**
 * @brief Maximum number of semaphores.
 *
 * Defines the maximum number of semaphores allowed in the OS abstraction layer.
 */
#define OSAL_SEM_NUM_MAX @OSAL_CONFIG_SEM_NUM_MAX@

/**
 * @brief Maximum number of timers.
 *
 * Defines the maximum number of timers allowed in the OS abstraction layer.
 */
#define OSAL_TIMER_NUM_MAX @OSAL_CONFIG_TIMER_NUM_MAX@

/**
 * @brief The size of the queue name.
 *
 * Defines the size of the queue name used in the OS abstraction layer.
 */
#define OSAL_QUEUE_NAME_SIZE @OSAL_CONFIG_QUEUE_NAME_SIZE@

/**
 * @brief Maximum number of queues.
 *
 * Defines the maximum number of queues allowed in the OS abstraction layer.
 */
#define OSAL_QUEUE_NUM_MAX @OSAL_CONFIG_QUEUE_NUM_MAX@

/**
 * @brief Maximum message length of a queue in bytes.
 *
 * Used by backends that keep the queue storage in the library (Zephyr,
 * FreeRTOS). Has no effect on backends that do not use it (Linux).
 */
#define OSAL_QUEUE_MSG_MAX_SIZE @OSAL_CONFIG_QUEUE_MSG_MAX_SIZE@

/**
 * @brief Maximum number of messages per queue.
 *
 * Used by backends that keep the queue storage in the library (Zephyr,
 * FreeRTOS). Has no effect on backends that do not use it (Linux).
 */
#define OSAL_QUEUE_MSG_NUM_MAX @OSAL_CONFIG_QUEUE_MSG_NUM_MAX@

/**
 * @brief Message buffer size per queue in bytes, derived as
 * @ref OSAL_QUEUE_MSG_MAX_SIZE * @ref OSAL_QUEUE_MSG_NUM_MAX.
 */
#define OSAL_QUEUE_BUF_SIZE (OSAL_QUEUE_MSG_MAX_SIZE * OSAL_QUEUE_MSG_NUM_MAX)

/**
 * @brief Maximum number of the log modules.
 *
 * Defines the maximum number of the log modules allowed in the OS abstraction layer.
 */
#define OSAL_LOG_MODULE_NUM_MAX @OSAL_CONFIG_LOG_MODULE_NUM_MAX@

/**
 * @brief The size of log module name.
 *
 * Defines the size of the log module name used in the OS abstraction layer.
 */
#define OSAL_LOG_MODULE_NAME_SIZE @OSAL_CONFIG_LOG_MODULE_NAME_SIZE@

/**
 * @brief The size of the log string buffer.
 *
 * Defines the size of the log string buffer used in the OS abstraction layer.
 */
#define OSAL_LOG_STRING_SIZE @OSAL_CONFIG_LOG_STRING_SIZE@

/**
 * @brief Maximum number of the time check point.
 *
 * Defines the maximum number of the time check point allowed in the
 * OS abstraction layer.
 */
#define OSAL_TMCHECK_NUM_MAX @OSAL_CONFIG_TMCHECK_NUM_MAX@

#ifdef __cplusplus	/* extern "C" */
}
#endif

#endif //OSAL_CONFIG_H

/** @}*/
